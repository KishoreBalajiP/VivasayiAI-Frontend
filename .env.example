# Vivasayi AI frontend — required environment variables.
#
# Vite exposes any VITE_* variable to the browser at build/runtime time. Never put
# private secrets (API keys, Cognito client secret, S3 credentials) in these files —
# they become public in the shipped bundle.
#
# All four variables below are REQUIRED for the frontend to function. Values below are
# placeholders — replace them with your real configuration. Do not commit real values.

# Backend API base URL (no trailing slash). REQUIRED for all API calls.
VITE_API_URL=https://api.example.com

# Cognito Hosted UI domain for the sign-in flow (authorize URL). REQUIRED for login.
VITE_COGNITO_DOMAIN=your-user-pool-domain.auth.ap-south-1.amazoncognito.com

# Cognito app client ID for the Hosted UI. Public (client-side) by design, but it MUST
# match the backend's COGNITO_CLIENT_ID (the backend uses the same audience).
VITE_COGNITO_REDIRECT_URI=https://app.example.com
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id