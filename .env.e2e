# Vite environment for the hermetic Playwright suite (`vite --mode e2e`, see playwright.config.ts and
# e2e/README.md). COMMITTED ON PURPOSE: it holds no secrets, only loopback addresses of the hermetic
# backend harness (VivasayiAI/scripts/e2e/hermeticBackend.js). playwright.config.ts also passes the
# same values in the Vite process environment, which beats any .env* file, so a developer's
# .env / .env.local can never point an e2e run at a real backend, tile server or geocoder.
#
#   18080  the product API (app.js) with a fake Gemini and mock storage / land records / weather / satellite
#   18081  the e2e control server (tiles, geocoder stubs, /__e2e/* test controls)
#   15173  this Vite dev server
VITE_API_URL=http://127.0.0.1:18080
VITE_MAP_TILE_URL=http://127.0.0.1:18081/tiles/{z}/{x}/{y}.png
VITE_GEOCODER_URL=http://127.0.0.1:18081/geocode/search
# Cognito is never reached: the tests inject a harness-minted session into sessionStorage
# (e2e/fixtures.ts). `.invalid` is a reserved TLD (RFC 2606), so a stray login cannot resolve.
VITE_COGNITO_DOMAIN=cognito.e2e.invalid
VITE_COGNITO_CLIENT_ID=e2e
VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:15173
